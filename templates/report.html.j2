            <a href="https://owasp.org/www-community/attacks/SQL_Injection" target="_blank">OWASP SQL Injection Guide</a>
        </p>
    </footer>
</div>

<!-- JAVASCRIPT -->
<script>
    function showAiTab(tab) {
        document.querySelectorAll('.ai-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.ai-tab').forEach(el => el.classList.remove('active'));
        document.getElementById(tab + '-tab').classList.add('active');
        event.target.classList.add('active');
    }

    window.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
            window.print();
        }
    });
</script>
